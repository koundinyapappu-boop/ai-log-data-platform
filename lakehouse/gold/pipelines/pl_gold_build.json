{
  "name": "pl_gold_build",
  "properties": {
    "description": "Gold layer build pipeline for the banking AI log analytics platform. Builds the fact_transactions Delta table, then builds daily and hourly aggregates that depend on it. After both notebooks succeed, refreshes Synapse external tables and materialized views via a stored procedure. On success POSTs a structured JSON payload to a Logic App webhook; on any upstream failure POSTs an alert payload to the same endpoint.",
    "parameters": {
      "batch_id": {
        "type": "string",
        "defaultValue": ""
      },
      "process_date": {
        "type": "string",
        "defaultValue": ""
      },
      "logic_app_webhook_url": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "variables": {
      "pipeline_status": {
        "type": "String",
        "defaultValue": "RUNNING"
      },
      "notification_payload": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "nb_build_fact_transactions",
        "description": "Executes gld_build_fact_transactions notebook. Applies business rules, SCD Type 2 logic, and surrogate key generation to the silver transactions Delta table, writing the result to gold/fact_transactions. This is the entry-point activity with no upstream dependencies.",
        "type": "ExecuteNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.04:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebook": {
            "referenceName": "gld_build_fact_transactions",
            "type": "NotebookReference"
          },
          "parameters": {
            "batch_id": {
              "value": {
                "value": "@pipeline().parameters.batch_id",
                "type": "Expression"
              },
              "type": "string"
            },
            "process_date": {
              "value": {
                "value": "@pipeline().parameters.process_date",
                "type": "Expression"
              },
              "type": "string"
            },
            "silver_container": {
              "value": "silver",
              "type": "string"
            },
            "gold_container": {
              "value": "gold",
              "type": "string"
            },
            "source_table": {
              "value": "transactions",
              "type": "string"
            },
            "target_table": {
              "value": "fact_transactions",
              "type": "string"
            }
          },
          "snapshot": true,
          "sparkPool": {
            "referenceName": "sparkPoolSmall",
            "type": "BigDataPoolReference"
          },
          "executorSize": "Medium",
          "conf": {
            "spark.dynamicAllocation.enabled": true,
            "spark.dynamicAllocation.minExecutors": 3,
            "spark.dynamicAllocation.maxExecutors": 10
          },
          "numExecutors": 4
        }
      },
      {
        "name": "nb_build_aggregates",
        "description": "Executes gld_build_aggregates notebook after fact_transactions is ready. Computes daily and hourly aggregate tables (transaction volumes, anomaly scores, model feature vectors) from the fact layer for BI dashboards and AI model consumption.",
        "type": "ExecuteNotebook",
        "dependsOn": [
          {
            "activity": "nb_build_fact_transactions",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebook": {
            "referenceName": "gld_build_aggregates",
            "type": "NotebookReference"
          },
          "parameters": {
            "batch_id": {
              "value": {
                "value": "@pipeline().parameters.batch_id",
                "type": "Expression"
              },
              "type": "string"
            },
            "process_date": {
              "value": {
                "value": "@pipeline().parameters.process_date",
                "type": "Expression"
              },
              "type": "string"
            },
            "gold_container": {
              "value": "gold",
              "type": "string"
            },
            "fact_table": {
              "value": "fact_transactions",
              "type": "string"
            },
            "aggregates_table": {
              "value": "aggregates",
              "type": "string"
            }
          },
          "snapshot": true,
          "sparkPool": {
            "referenceName": "sparkPoolSmall",
            "type": "BigDataPoolReference"
          },
          "executorSize": "Small",
          "conf": {
            "spark.dynamicAllocation.enabled": true,
            "spark.dynamicAllocation.minExecutors": 2,
            "spark.dynamicAllocation.maxExecutors": 6
          },
          "numExecutors": 3
        }
      },
      {
        "name": "scr_refresh_synapse_views",
        "description": "Calls dbo.usp_refresh_gold_external_tables stored procedure to rebuild Synapse Analytics external tables and update materialized views pointing at the refreshed gold ADLS Gen2 layer. Runs after both gold notebooks succeed.",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "nb_build_aggregates",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "linkedService": {
            "referenceName": "ls_synapse_sql_dedicated",
            "type": "LinkedServiceReference"
          },
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "EXEC [dbo].[usp_refresh_gold_external_tables]\n    @process_date = '@{pipeline().parameters.process_date}',\n    @batch_id     = '@{pipeline().parameters.batch_id}';",
                "type": "Expression"
              }
            }
          ]
        }
      },
      {
        "name": "set_pipeline_status_success",
        "description": "Sets the pipeline_status variable to SUCCESS immediately after view refresh completes. Used by the success notification activity.",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "scr_refresh_synapse_views",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "variableName": "pipeline_status",
          "value": "SUCCESS"
        }
      },
      {
        "name": "web_notify_success",
        "description": "POSTs a structured JSON payload to the Logic App webhook URL on successful pipeline completion. The payload includes pipeline name, batch_id, process_date, pipeline run ID, and UTC completion timestamp for downstream consumer coordination.",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "set_pipeline_status_success",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 15,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "url": {
            "value": "@pipeline().parameters.logic_app_webhook_url",
            "type": "Expression"
          },
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "value": "@json(concat('{\"pipeline_name\":\"pl_gold_build\",\"status\":\"SUCCESS\",\"batch_id\":\"', pipeline().parameters.batch_id, '\",\"process_date\":\"', pipeline().parameters.process_date, '\",\"pipeline_run_id\":\"', pipeline().RunId, '\",\"completed_at\":\"', utcnow(), '\",\"message\":\"Gold layer build completed successfully. Downstream BI and AI consumers may now query the gold layer.\"}'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "web_notify_failure",
        "description": "POSTs a failure alert to the Logic App webhook if nb_build_fact_transactions, nb_build_aggregates, or scr_refresh_synapse_views fails. Fires on any of those three activities entering a Failed state so no error is silently dropped.",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "nb_build_fact_transactions",
            "dependencyConditions": [
              "Failed"
            ]
          },
          {
            "activity": "nb_build_aggregates",
            "dependencyConditions": [
              "Failed"
            ]
          },
          {
            "activity": "scr_refresh_synapse_views",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 15,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "url": {
            "value": "@pipeline().parameters.logic_app_webhook_url",
            "type": "Expression"
          },
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "value": "@json(concat('{\"pipeline_name\":\"pl_gold_build\",\"status\":\"FAILED\",\"batch_id\":\"', pipeline().parameters.batch_id, '\",\"process_date\":\"', pipeline().parameters.process_date, '\",\"pipeline_run_id\":\"', pipeline().RunId, '\",\"failed_at\":\"', utcnow(), '\",\"message\":\"Gold layer build FAILED. Inspect Synapse Monitor for run ID: ', pipeline().RunId, '. Gold data may be stale.\"}'))",
            "type": "Expression"
          }
        }
      }
    ],
    "annotations": [
      "layer:gold",
      "domain:banking",
      "platform:ai-log-analytics"
    ],
    "folder": {
      "name": "lakehouse/gold"
    }
  }
}
