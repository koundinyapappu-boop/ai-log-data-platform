{
  "name": "pl_bronze_ingest",
  "properties": {
    "description": "Bronze layer ingestion pipeline for the banking AI log analytics platform. Reads the last watermark from the Synapse SQL control table, executes the brz_ingest_logs notebook via a Spark pool, updates the watermark on success, and routes failures to the error handling pipeline. Scheduled every 15 minutes.",
    "parameters": {
      "batch_id": {
        "type": "string",
        "defaultValue": ""
      },
      "ingestion_date": {
        "type": "string",
        "defaultValue": ""
      },
      "source_system": {
        "type": "string",
        "defaultValue": "banking_ai_logs"
      }
    },
    "variables": {
      "pipeline_status": {
        "type": "String",
        "defaultValue": "RUNNING"
      },
      "watermark_value": {
        "type": "String",
        "defaultValue": "1970-01-01T00:00:00Z"
      },
      "error_message": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "lkp_get_watermark",
        "description": "Reads the last successfully processed watermark and run metadata from dbo.pipeline_control_table in Synapse Dedicated SQL. Returns a single row used to parametrise the ingestion notebook.",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "SqlDWSource",
            "sqlReaderQuery": {
              "value": "SELECT TOP 1\n    pipeline_name,\n    last_watermark_value,\n    last_successful_run,\n    source_system,\n    run_status\nFROM dbo.pipeline_control_table\nWHERE pipeline_name = 'pl_bronze_ingest'\n  AND source_system   = '@{pipeline().parameters.source_system}'\nORDER BY last_successful_run DESC;",
              "type": "Expression"
            },
            "queryTimeout": "00:02:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "ds_synapse_sql_control_table",
            "type": "DatasetReference"
          },
          "firstRowOnly": true
        }
      },
      {
        "name": "ifc_notebook_error_handling",
        "description": "IfCondition gate: evaluates whether a prior run is still marked RUNNING (concurrent execution guard). True branch skips with a notification; False branch proceeds with ingestion, watermark update, and failure routing.",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "lkp_get_watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@and(not(empty(activity('lkp_get_watermark').output.firstRow)), equals(activity('lkp_get_watermark').output.firstRow.run_status, 'RUNNING'))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "set_status_skipped",
              "description": "Marks pipeline_status as SKIPPED when a concurrent run is detected.",
              "type": "SetVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "pipeline_status",
                "value": "SKIPPED"
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "nb_ingest_logs",
              "description": "Executes the brz_ingest_logs Synapse notebook. Passes batch_id, ingestion_date, source_system, and the watermark retrieved from the control table so the notebook reads only new records.",
              "type": "ExecuteNotebook",
              "dependsOn": [],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "notebook": {
                  "referenceName": "brz_ingest_logs",
                  "type": "NotebookReference"
                },
                "parameters": {
                  "batch_id": {
                    "value": {
                      "value": "@pipeline().parameters.batch_id",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "ingestion_date": {
                    "value": {
                      "value": "@pipeline().parameters.ingestion_date",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "source_system": {
                    "value": {
                      "value": "@pipeline().parameters.source_system",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "last_watermark": {
                    "value": {
                      "value": "@if(empty(activity('lkp_get_watermark').output.firstRow), '1970-01-01T00:00:00Z', activity('lkp_get_watermark').output.firstRow.last_watermark_value)",
                      "type": "Expression"
                    },
                    "type": "string"
                  }
                },
                "snapshot": true,
                "sparkPool": {
                  "referenceName": "sparkPoolSmall",
                  "type": "BigDataPoolReference"
                },
                "executorSize": "Small",
                "conf": {
                  "spark.dynamicAllocation.enabled": true,
                  "spark.dynamicAllocation.minExecutors": 2,
                  "spark.dynamicAllocation.maxExecutors": 5
                },
                "numExecutors": 2
              }
            },
            {
              "name": "sp_update_watermark",
              "description": "Calls dbo.usp_update_pipeline_watermark to stamp the control table with the new watermark value and mark the run as SUCCESS. Only executes when nb_ingest_logs succeeds.",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "nb_ingest_logs",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "storedProcedureName": "[dbo].[usp_update_pipeline_watermark]",
                "storedProcedureParameters": {
                  "pipeline_name": {
                    "value": "pl_bronze_ingest",
                    "type": "String"
                  },
                  "batch_id": {
                    "value": {
                      "value": "@pipeline().parameters.batch_id",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "new_watermark_value": {
                    "value": {
                      "value": "@pipeline().parameters.ingestion_date",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "source_system": {
                    "value": {
                      "value": "@pipeline().parameters.source_system",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "run_status": {
                    "value": "SUCCESS",
                    "type": "String"
                  },
                  "run_datetime": {
                    "value": {
                      "value": "@utcNow()",
                      "type": "Expression"
                    },
                    "type": "DateTime"
                  }
                }
              },
              "linkedServiceName": {
                "referenceName": "ls_synapse_sql_dedicated",
                "type": "LinkedServiceReference"
              }
            },
            {
              "name": "sp_log_ingest_failure",
              "description": "Logs notebook failure to the control table, stamping run_status = FAILED so subsequent runs can proceed rather than deadlocking on the RUNNING guard.",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "nb_ingest_logs",
                  "dependencyConditions": [
                    "Failed"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "storedProcedureName": "[dbo].[usp_update_pipeline_watermark]",
                "storedProcedureParameters": {
                  "pipeline_name": {
                    "value": "pl_bronze_ingest",
                    "type": "String"
                  },
                  "batch_id": {
                    "value": {
                      "value": "@pipeline().parameters.batch_id",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "new_watermark_value": {
                    "value": {
                      "value": "@if(empty(activity('lkp_get_watermark').output.firstRow), '1970-01-01T00:00:00Z', activity('lkp_get_watermark').output.firstRow.last_watermark_value)",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "source_system": {
                    "value": {
                      "value": "@pipeline().parameters.source_system",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "run_status": {
                    "value": "FAILED",
                    "type": "String"
                  },
                  "run_datetime": {
                    "value": {
                      "value": "@utcNow()",
                      "type": "Expression"
                    },
                    "type": "DateTime"
                  }
                }
              },
              "linkedServiceName": {
                "referenceName": "ls_synapse_sql_dedicated",
                "type": "LinkedServiceReference"
              }
            },
            {
              "name": "ep_failure_handler",
              "description": "Triggers the dedicated pl_failure_handler pipeline after the failure has been logged, passing context for alerting and dead-letter queuing.",
              "type": "ExecutePipeline",
              "dependsOn": [
                {
                  "activity": "sp_log_ingest_failure",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "pl_failure_handler",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": false,
                "parameters": {
                  "failed_pipeline_name": {
                    "value": {
                      "value": "pl_bronze_ingest",
                      "type": "Expression"
                    }
                  },
                  "failed_batch_id": {
                    "value": {
                      "value": "@pipeline().parameters.batch_id",
                      "type": "Expression"
                    }
                  },
                  "failed_run_id": {
                    "value": {
                      "value": "@pipeline().RunId",
                      "type": "Expression"
                    }
                  },
                  "error_message": {
                    "value": {
                      "value": "@{activity('nb_ingest_logs').error.message}",
                      "type": "Expression"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "triggers": [
      {
        "name": "trg_bronze_ingest_15min",
        "properties": {
          "description": "Fires every 15 minutes to trigger the bronze ingestion pipeline for near-real-time log ingestion.",
          "type": "ScheduleTrigger",
          "typeProperties": {
            "recurrence": {
              "frequency": "Minute",
              "interval": 15,
              "startTime": "2024-01-01T00:00:00Z",
              "timeZone": "UTC"
            }
          },
          "pipelines": [
            {
              "pipelineReference": {
                "referenceName": "pl_bronze_ingest",
                "type": "PipelineReference"
              },
              "parameters": {
                "batch_id": {
                  "value": "@formatDateTime(trigger().scheduledTime, 'yyyyMMddHHmm')",
                  "type": "Expression"
                },
                "ingestion_date": {
                  "value": "@formatDateTime(trigger().scheduledTime, 'yyyy-MM-ddTHH:mm:ssZ')",
                  "type": "Expression"
                },
                "source_system": "banking_ai_logs"
              }
            }
          ]
        }
      }
    ],
    "annotations": [
      "layer:bronze",
      "domain:banking",
      "platform:ai-log-analytics",
      "schedule:every_15_minutes"
    ],
    "folder": {
      "name": "lakehouse/bronze"
    }
  }
}
